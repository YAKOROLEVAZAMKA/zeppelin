# =============================================================================
#  Метастор: подключения и порты. Скопируйте в .env и заполните.
#  .env лежит рядом с docker-compose.yml и НЕ коммитится в git.
# =============================================================================

# ── Хранилище каталога (новый контейнер postgres) ────────────────────────────
MS_DB_NAME=metastore
MS_DB_USER=metastore
MS_DB_PASSWORD=                 # придумайте пароль
MS_DB_PORT_EXTERNAL=5433        # порт наружу, чтобы ходить DBeaver-ом

# ── Порт, на котором nginx отдаёт панель и каталог ───────────────────────────
# ВАЖНО: этот же порт прописан в zeppelin-site.xml, в свойстве
# zeppelin.server.html.body.addon. Меняете здесь — поменяйте и там.
MS_WEB_PORT=8086

# ── Источник 1: ClickHouse (нативный протокол, порт 9000) ────────────────────
CH_HOST=
CH_PORT=9000
CH_USER=
CH_PASSWORD=

# ── Источник 2: Greengage ────────────────────────────────────────────────────
GP_HOST=
GP_PORT=5432
GP_DB=
GP_USER=
GP_PASSWORD=

# ── Источник 3: старая PostgreSQL с метаданными (необязательно) ──────────────
# Оставьте PGMD_HOST пустым — источник просто пропустится.
PGMD_HOST=
PGMD_PORT=5432
PGMD_DB=
PGMD_USER=
PGMD_PASSWORD=

# ── Внутренний PyPI, если наружу закрыто (иначе оставьте пустым) ─────────────
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
